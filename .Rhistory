mu <- function(t){
rep(length(t))
}
mu(c(1,2,3))
mu <- function(t){
rep(0.05, times = length(t))
}
mu(c(1,2,3))
integrate(sin, lower = 0, upper = pi)
integrate(sin, lower = 0, upper = pi)$value
tpx <- function(t,x) {
exp(-integrate(mu, lower = x, upper = t + x)$value)
}
tpx(20,30)
