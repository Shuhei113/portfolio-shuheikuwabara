reviews_text_only <- final_dataset %>%
select(review_id, text)
sentiment_scores <- reviews_text_only %>%
unnest_tokens(word, text) %>%                 # 1. 単語に分解
inner_join(get_sentiments("bing")) %>%        # 2. 感情辞書と結合
count(review_id, sentiment) %>%               # 3. レビューごとにポジ/ネガをカウント
pivot_wider(names_from = sentiment,
values_from = n,
values_fill = 0) %>%              # 4. 横持ちデータに変換
mutate(sentiment_score = positive - negative) # 5. スコア算出（ポジティブ数 - ネガティブ数）
final_dataset_with_sentiment <- final_dataset %>%
inner_join(sentiment_scores, by = "review_id")
glimpse(final_dataset_with_sentiment)
state_counts <- business_df %>%
group_by(state) %>%
summarise(total_reviews = sum(review_count)) %>%
slice_max(total_reviews, n = 10) # 上位10州を表示
ggplot(state_counts, aes(x = reorder(state, total_reviews), y = total_reviews)) +
geom_col(fill = "#4e79a7") + # アカデミックな落ち着いた色
coord_flip() +
scale_y_continuous(labels = scales::comma) +
theme_minimal() +
labs(title = "Total Review Volume by State",
subtitle = "Pennsylvania (PA) contains the highest density of data",
x = "State", y = "Total Reviews")
ggplot(final_dataset_with_sentiment,
aes(x = as.factor(stars_review), y = sentiment_score)) +
geom_boxplot(fill = "lightblue", outlier.shape = NA) +
