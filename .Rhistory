file_path <- "yelp_dataset/yelp_academic_dataset_business.json"
business_df <- stream_in(file(file_path), flatten = TRUE) %>%
as_tibble()
glimpse(business_df)
category_analysis_df <- business_df %>%
separate_rows(categories, sep = ", ") %>%
filter(!categories %in% c("", "Restaurants", "Food")) %>%
group_by(categories) %>%
summarise(
business_count = n(),
total_reviews = sum(review_count),
avg_stars = mean(stars),
median_stars = median(stars)
) %>%
ungroup() %>%
slice_max(total_reviews, n = 20)
print(category_analysis_df)
top_categories <- category_analysis_df$categories
plot_data <- business_df %>%
separate_rows(categories, sep = ", ") %>%
filter(categories %in% top_categories)
p1 <- ggplot(category_analysis_df, aes(x = reorder(categories, total_reviews), y = total_reviews)) +
geom_col(fill = "steelblue") +
coord_flip() + # 横向き棒グラフにする
scale_y_continuous(labels = scales::comma) + # 数字にカンマを入れる
theme_minimal() +
labs(title = "Top 20 Categories by Total Review Volume",
x = "Category", y = "Total Reviews")
print(p1)
p2 <- ggplot(plot_data, aes(x = reorder(categories, stars, FUN = median), y = stars)) +
geom_boxplot(fill = "lightgreen", alpha = 0.7) +
coord_flip() +
theme_minimal() +
labs(title = "Distribution of Star Ratings by Category",
subtitle = "Do some categories naturally get higher ratings?",
x = "Category", y = "Average Business Stars")
print(p2)
target_businesses <- business_df %>%
filter(state == "PA",
str_detect(categories, "Restaurants")) %>%
select(business_id, name, stars, categories)
target_ids <- target_businesses$business_id
print(paste(length(target_ids)))
review_file <- "yelp_dataset/yelp_academic_dataset_review.json"
stream_filter_reviews <- function(file_path, target_ids, chunk_size = 100000) {
con <- file(file_path, "r")
results <- list()
i <- 1
while (TRUE) {
lines <- readLines(con, n = chunk_size, warn = FALSE)
if (length(lines) == 0) break
chunk_df <- lines %>%
lapply(function(x) fromJSON(x, flatten = TRUE)) %>%
bind_rows()
filtered_chunk <- chunk_df %>%
filter(business_id %in% target_ids) %>%
select(review_id, business_id, stars, date, text) # 必要な列だけ残す（軽量化）
results[[i]] <- filtered_chunk
i <- i + 1
cat(sprintf("Processed chunk %d... (Rows found: %d)\n", i-1, nrow(filtered_chunk)))
}
close(con)
final_df <- bind_rows(results)
return(final_df)
}
reviews_df <- stream_filter_reviews(review_file, target_ids)
final_dataset <- reviews_df %>%
inner_join(target_businesses, by = "business_id", suffix = c("_review", "_biz"))
write_rds(final_dataset, "pa_restaurants_reviews.rds")
glimpse(final_dataset)
reviews_text_only <- final_dataset %>%
select(review_id, text)
sentiment_scores <- reviews_text_only %>%
unnest_tokens(word, text) %>%                 # 1. 単語に分解
inner_join(get_sentiments("bing")) %>%        # 2. 感情辞書と結合
count(review_id, sentiment) %>%               # 3. レビューごとにポジ/ネガをカウント
pivot_wider(names_from = sentiment,
values_from = n,
values_fill = 0) %>%              # 4. 横持ちデータに変換
mutate(sentiment_score = positive - negative) # 5. スコア算出（ポジティブ数 - ネガティブ数）
